package entities;

import java.text.SimpleDateFormat;

public class UsedProduct extends Product{

	private static SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
	
	private Double manufactureDate;
	
	public UsedProduct() {
		super();
	}

	public UsedProduct(String name, Double price, Double manufactureDate) {
		super(name, price);
		this.manufactureDate = manufactureDate;
	}

	public Double getManufactureDate() {
		return manufactureDate;
	}

	public void setManufactureDate(Double manufactureDate) {
		this.manufactureDate = manufactureDate;
	}
	
	@Override
	public String priceTag() {
		StringBuilder sb = new StringBuilder();
		sb.append(getName());
		sb.append(" (used) $ ");
		sb.append(String.format("%.2f", getPrice()));
		sb.append(" (Manufacture fee: $ ");
		//sb.append(String.format("%.2f", customFee));
		sb.append(")");
		return sb.toString();
	}
}
